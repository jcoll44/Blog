source "https://rubygems.org"

# Use the github-pages gem so local builds match GitHub Pages' environment exactly.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end

# Lock http_parser.rb for newer Ruby compatibility
gem "webrick", "~> 1.8"
